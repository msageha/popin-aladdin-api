# popIn Aladdin の IP（同一 LAN）。スキーム付きで指定する。
POPIN_ALADDIN_HOST=http://172.16.1.113

# UPnP/DLNA MediaRenderer のポートと device description のパス（通常は変更不要）。
UPNP_PORT=1481
DESCRIPTION_PATH=/

# 独自 popIn/MAXHUB 制御プロトコルのポート（ライト=TCP, 方向キー=UDP）。
CONTROL_TCP_PORT=30913
CONTROL_UDP_PORT=16735

# 認証は不要だが、参考用に保持できる（ローカル制御では未使用）。
USERNAME=
PASSWORD=

# SOAP / 制御リクエストのタイムアウト（秒）。
TIMEOUT=10
